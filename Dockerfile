# Generated by Kairo for kairo-node-sample. Node 22, npm.
# -slim (Debian, glibc): native modules such as sqlite3 have prebuilt binaries
# for it, so npm needs no compiler. On Alpine (musl) they compile and fail.
FROM node:22-slim

WORKDIR /app

COPY . .
RUN npm ci --omit=dev

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["npm","start"]
